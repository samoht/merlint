depends: [
  "dune" {>= "3.21"}
  "ocaml"
  "bytesrw"
  "cmdliner"
  "eio"
  "merlin"
  "merlin-lib"
  "re"
  "fpath"
  "logs"
  "fmt"
  "base-unix"
  "astring"
  "nox-sexp"
  "nox-dune"
  "nox-opam"
  "nox-toml"
  "nox-json"
  "console"
  "console-eio"
  "probe"
  "observe"
  "eio_main"
  "project-index"
  "dune-build-info"
  "alcotest" {with-test}
