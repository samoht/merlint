# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml linter enforcing modern coding conventions"
description:
  "An opinionated OCaml linter that enforces modern OCaml coding conventions and best practices"
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["org:blacksun" "cli" "test"]
homepage: "https://tangled.org/gazagnaire.org/merlint"
bug-reports: "https://tangled.org/gazagnaire.org/merlint/issues"
depends: [
  "ocaml"
  "dune" {>= "3.21"}
  "bytesrw"
  "cmdliner"
  "eio"
  "ocaml-merlin"
  "merlin-lib"
  "re"
  "fpath"
  "logs"
  "fmt"
  "base-unix"
  "astring"
  "nox-sexp"
  "nox-dune"
  "nox-opam"
  "nox-toml"
  "nox-tty"
  "vlog"
  "eio_main"
  "nox-memtrace"
  "ocaml-project-index"
  "dune-build-info"
  "alcotest" {with-test}
  "mdx" {with-test}
  "nox-loc"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/merlint"
x-maintenance-intent: ["(latest)"]
x-quality-build: "2026-04-15"
x-quality-test: "2026-04-15"
