(cram
 (deps
  %{bin:merlint}
  ; nox-csv's own local dependencies: a (package ...) dep installs that package
  ; alone, not the tree below it, so the sandbox needs each one named.
  (package nox-csv)
  (package nox-loc)
  (package nox-utf8))
 (locks merlint-cram-dune))

(rule
 (alias runtest)
 (deps
  ../../scripts/check_test_integrity.exe
  (source_tree .))
 (action
  (chdir
   ../..
   (run scripts/check_test_integrity.exe))))
