(executable
 (name fuzz_parser)
 (libraries alcobar))

(rule
 (alias runtest)
 (deps fuzz_parser.exe)
 (action
  (run %{exe:fuzz_parser.exe})))

(rule
 (alias fuzz)
 (enabled_if
  (= %{profile} afl))
 (deps
  (source_tree corpus)
  fuzz_parser.exe
  gen_corpus.exe)
 (action
  (progn
   (run %{exe:fuzz_parser.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz_parser.exe} @@))))
