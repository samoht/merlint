(test
 (name test)
 (libraries
  merlint
  merlint_doc
  ocaml-merlin
  ocaml-project-index
  alcotest
  alcotest.engine
  compiler-libs.common
  eio
  eio_main
  fpath
  merlin-lib.ocaml_typing
  unix
  logs.fmt
  fmt
  re
  fmt.tty))

; Merlint lints its own sources: the linter must pass the rules it enforces.
; Run from the package root (chdir ..) so merlint resolves the real project root
; -- the one carrying dune-project, .ocamlformat and the dune-warnings env stanza
; -- and the project-structure rules (E500, E940) see them instead of the test
; sandbox. These root files are listed as deps so they are materialised there.

(rule
 (alias runtest)
 (deps
  %{bin:merlint}
  (source_tree ../lib)
  (source_tree ../bin)
  ../.ocamlformat
  ../dune
  ../dune-project)
 (action
  (chdir
   ..
   (run merlint lib bin))))
